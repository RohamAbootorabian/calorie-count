# Copy to `.env` and fill in. Anything prefixed EXPO_PUBLIC_ is bundled into the
# app and visible to clients — only put PUBLIC values here.
#
# Get these from your Supabase project: Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: The AI provider key (OPENAI_API_KEY) is NEVER stored here or in the app.
# It lives only as a secret on the Supabase Edge Function that runs the photo
# analysis. The phone calls the function; the function calls the AI.
